{
  "uid": "phylo-logs",
  "title": "Phylogenetic Pipeline Logs",
  "tags": ["logs", "loki"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "fastapi,orchestrator,iqtree,fastreer,mrbayes,merger,comparison",
        "current": { "text": "All", "value": "$__all" },
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "fastapi",    "value": "fastapi" },
          { "text": "orchestrator", "value": "orchestrator" },
          { "text": "iqtree",     "value": "iqtree" },
          { "text": "fastreer",   "value": "fastreer" },
          { "text": "mrbayes",    "value": "mrbayes" },
          { "text": "merger",     "value": "merger" },
          { "text": "comparison", "value": "comparison" }
        ],
        "includeAll": true,
        "multi": false,
        "hide": 0
      },
      {
        "name": "job_id",
        "label": "Job ID",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "All Logs",
      "type": "logs",
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 0 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-datasource" },
          "expr": "{service=~\"$service\"}",
          "legendFormat": "",
          "maxLines": 1000,
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "loki-datasource" },
          "expr": "{job_id=\"$job_id\"}",
          "legendFormat": "",
          "maxLines": 1000,
          "refId": "B",
          "hide": false
        }
      ],
      "datasource": { "type": "loki", "uid": "loki-datasource" }
    },
    {
      "id": 2,
      "title": "Log Volume",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-datasource" },
          "expr": "sum by (service) (count_over_time({service=~\".+\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "loki", "uid": "loki-datasource" }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
