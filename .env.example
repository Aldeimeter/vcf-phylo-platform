# Host port configuration
# Only ports exposed to the host machine are configurable.
# Internal service-to-service communication uses Docker's network and is unaffected by these values.

# Docker network name
NETWORK_NAME=phylo-net

# Docker registry port
# macOS users: port 5000 conflicts with AirPlay Receiver, use 5001
REGISTRY_PORT=5000

# FastAPI backend port
FASTAPI_PORT=8000

# Web frontend port
FRONTEND_PORT=8080

# Grafana dashboard port
GRAFANA_PORT=3000
